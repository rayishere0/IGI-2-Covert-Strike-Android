// THE LONG DESCENT - EPIC MILITARY COMPOUND MISSION
// Mission 99: Intelligence Extraction
// Phase 4 Enhanced: 15-Guard Military Base, 1024x1024 Terrain
// ============================================================

// MISSION BRIEFING:
// You are positioned on high ground overlooking an enemy military
// compound deep in foreign territory. CIA has confirmed a top-secret
// intelligence chip containing weapon locations is stored in the
// compound's secure vault. Eliminate or evade the 15-man guard force,
// locate and extract the chip, and reach the extraction point at
// the lake. Time is critical.

// --- PLAYER SPAWN & EQUIPMENT ---
HumanPlayer(
    Position = (200, 200, 160)
    Gamma = 225
    Model = 'player'
    Team = 0
    Weapon = 'SetupWeapons'
    1st Person Model = 'arms_player'
    Visibility Gamma = 2.0
    Visibility Minimum = 0.1
    Visibility Maximum = 0.9
    Carry over weapons from previous mission = FALSE
);

// Elite operative loadout: long-range + close-quarters + melee
SetupWeapons()
{
    GiveWeapon(SniperRifle);
    SetAmmo(SniperRifle, 180);      // Extended sniper ammo for multiple targets
    GiveWeapon(AssaultRifle);
    SetAmmo(AssaultRifle, 240);     // Full combat load
    GiveWeapon(Pistol);
    SetAmmo(Pistol, 90);            // Backup sidearm
    GiveWeapon(Knife);               // Silent eliminations
}

