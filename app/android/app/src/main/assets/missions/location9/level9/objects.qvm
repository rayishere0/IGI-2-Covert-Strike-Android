// --- GUARD ARMAMENT ---
GuardArmed()
{
    GiveWeapon(AssaultRifle);       // Standard military rifle
    SetAmmo(AssaultRifle, 180);     // Full combat load per guard
    GiveWeapon(Pistol);             // Backup sidearm
    SetAmmo(Pistol, 60);            // Secondary ammunition
}

// --- PRIMARY OBJECTIVES ---
// Primary: Extract intelligence chip from vault (located in guard at 'Vault Guard' position)
// Secondary: Minimize casualties (stealth preferred)
// Extraction: Reach lake shore within time limit

// --- EXTRACTION ZONE ---
// Location: (1600, 1800, 2)
// Description: Abandoned dock at lake shore - friendly forces waiting
// Radius: 30 units for extraction success

// --- ENVIRONMENTAL OVERVIEW ---
// Terrain: 1024x1024 unit epic map
// North: Mountain highlands (player spawn ~160m elevation)
// Center: Military compound with multiple structures
//   - Guard towers at north and northeast
//   - Main administrative building
//   - Barracks and vehicle bay
//   - Secure vault containing intelligence
// South: Valley terrain with forest cover
// East: Lake (extraction point)

// --- MISSION PARAMETERS ---
Mission Difficulty = AGENT           // Normal operative difficulty
Time Limit = 45 minutes              // Professional operation window
Reinforcements = None                // Solo operation - no backup
Extraction Timeout = 50 minutes      // Must exit before limit
Success Condition = Chip + Extraction// Retrieve AND extract
Failure Condition = Mission Capture OR Time Expired

